# ---------- Server ----------
PORT=8080
AYHK_PARTNER_KEY=change-me-long-random-string
AYHK_KIOSK_KEY=change-me-another-long-random-string
AYHK_DATA_FILE=server/data/ayhk.json
# Allow the website or dashboard to call the API from another domain (default *)
# AYHK_CORS_ORIGIN=https://ayhk.example

# ---------- Apps (baked in at build time) ----------
# Leave empty when the apps are served by the same server
VITE_API_URL=
# Kiosk only: set per machine
VITE_KIOSK_ID=K01
VITE_KIOSK_KEY=change-me-another-long-random-string
VITE_HARDWARE=sim
VITE_BRIDGE_URL=http://localhost:8787
VITE_MOMO_MERCHANT_ID=
# Website contact line (hidden while empty)
VITE_CONTACT_EMAIL=
VITE_RESPONSE_PROMISE=
